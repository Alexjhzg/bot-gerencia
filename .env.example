# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Configuration
# The ID of your Google Spreadsheet (found in the sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Google Service Account Credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
# The private key must include the begin/end headers. In .env, you should replace the actual linebreaks in the key with '\n' characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgkqhkiG9w0BAQEFAASCBKkwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Manager Telegram Chat ID for automated report delivery
MANAGER_CHAT_ID=your_manager_telegram_chat_id_here
# Acting Manager Telegram Chat ID (optional / temporary replacement)
ACTING_MANAGER_CHAT_ID=your_acting_manager_telegram_chat_id_here

# --- OPTIONAL VARIABLES (Already set to defaults in code) ---
# TZ=America/Caracas
# SHIFT_1_LIMIT=12:30
# SHIFT_2_LIMIT=17:00

